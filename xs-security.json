{
  "xsappname": "pm_workorder",
  "tenant-mode": "dedicated",

  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin access"
    }
  ],

  "role-templates": [
    {
      "name": "Admin",
      "description": "Admin role",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    }
  ],

  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.ap21.trial.applicationstudio.cloud.sap/**",
      "https://*.cfapps.ap21.hana.ondemand.com/**"
    ],
    "credential-types": [
      "binding-secret"
    ]
  }
}